{
  "name": "ibms-redesign",
  "productName": "IBMS",
  "version": "0.1.0",
  "description": "IBMS Redesign: desktop app for Bangladesh land-port management",
  "private": true,
  "author": "rms1585",
  "repository": "github:rms1585/ibms-redesign",
  "homepage": "https://rms1585.github.io/ibms-redesign/",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "bd.gov.blpa.ibms",
    "productName": "IBMS",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/public-sans": "^5.1.0",
    "@mui/icons-material": "^6.1.7",
    "@mui/material": "^6.1.7",
    "@mui/x-charts": "^7.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
